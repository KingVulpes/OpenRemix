      if(material.a>1.5) {
        indirect=REBLUR_BackEnd_UnpackRadianceAndNormHitDist(temporal.flags.y!=0?imageLoad(pbrDiffuseOutput,p):imageLoad(sh0,p)).rgb;
        specular=REBLUR_BackEnd_UnpackRadianceAndNormHitDist(temporal.flags.y!=0?imageLoad(pbrSpecularOutput,p):imageLoad(pbrSpecularInput,p)).rgb;
        specular*=imageLoad(pbrSpecularFactor,p).rgb;
      } else if(temporal.flags.y!=0) {
        NRD_SG sg=REBLUR_BackEnd_UnpackSh(imageLoad(outSh0,p),imageLoad(outSh1,p).xyz);
        vec3 N=normalAt(p);
        vec4 nearPoint=temporal.inverseCamera*vec4((vec2(p)+.5+temporal.jitter.xy)/vec2(size)*2-1,0,1);
        vec4 farPoint=temporal.inverseCamera*vec4((vec2(p)+.5+temporal.jitter.xy)/vec2(size)*2-1,.99999,1);
        vec3 V=normalize(nearPoint.xyz/nearPoint.w-farPoint.xyz/farPoint.w);
        indirect=NRD_SG_ResolveDiffuse(sg,N,V,1);
        vec2 factor=NRD_SG_ReJitter(sg,sg,V,1,z,depthAt(p+ivec2(1,0)),depthAt(p-ivec2(1,0)),depthAt(p+ivec2(0,1)),depthAt(p-ivec2(0,1)),
          N,normalAt(p+ivec2(1,0)),normalAt(p-ivec2(1,0)),normalAt(p+ivec2(0,1)),normalAt(p-ivec2(0,1)));
        indirect*=factor.x;
      }
      vec3 direct=imageLoad(directLight,p).rgb;
#ifdef SIGMA_PASS
      direct*=SIGMA_BackEnd_UnpackShadow(imageLoad(shadowOutput,p)).yzw;
#endif
      vec3 local=vec3(0);
#ifdef LOCAL_PASS
      if(temporal.local.w!=0?temporal.families.x!=0:temporal.local.y!=0)
        local=REBLUR_BackEnd_UnpackRadianceAndNormHitDist(temporal.local.x!=0&&material.a<1.5?imageLoad(localOutput,p):imageLoad(localInput,p)).rgb;
#endif
#ifdef SPLIT_LOCAL_PASS
      if(temporal.families.y!=0)
        local+=REBLUR_BackEnd_UnpackRadianceAndNormHitDist(temporal.local.x!=0&&material.a<1.5?imageLoad(emissiveOutput,p):imageLoad(emissiveInput,p)).rgb;
#endif
      color=direct+safeRadiance(indirect+local)*material.rgb+safeRadiance(specular);
      Mirror mirror=loadMirror(p);
      if(mirror.replaced)color*=mirror.reflectance;
    }
    if(pass.step==0) {
      imageStore(composed,p,vec4(safeRadiance(color),1));return;
    }
    vec4 tr=imageLoad(transmittance,p);
    vec3 foreground=imageLoad(transparentLight,p).rgb;
    if(temporal.translucency.x!=0) {
      vec4 factor=imageLoad(frontAlbedo,p);
      if(factor.a>0)foreground+=filteredForeground(p,factor);
    }
    color=safeRadiance(foreground+tr.rgb*color);
    if(temporal.timing.y!=0&&temporal.flags.y!=0)color=imageLoad(validation,p).rgb;
#ifdef SIGMA_PASS
    if(temporal.shadow.y!=0)
      color=z>=500000?vec3(0):temporal.shadow.y==1?imageLoad(shadowInput,p).yzw:
            SIGMA_BackEnd_UnpackShadow(imageLoad(shadowOutput,p)).yzw;
#endif
    imageStore(composed,p,vec4(color,1-tr.a));return;
  }
  if(pass.mode==3) {
    vec4 inputColor=imageLoad(composed,p);vec3 current=compressed(inputColor.rgb),result=current;
    float rate=1;
    if(temporal.flags.z!=0) {
      vec3 m1=vec3(0),m2=vec3(0);float sum=0;
      vec4 reconstructed=vec4(0);float reconstructionWeight=0;
      int radius=inputColor.a>0?2:1;ivec2 nearest=p;float minZ=depthAt(p);
