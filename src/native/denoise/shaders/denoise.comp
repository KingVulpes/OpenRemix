#version 460
#extension GL_GOOGLE_include_directive : require
#include "inputs.glsl"
#include "../../pathtrace/shaders/debug.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(push_constant) uniform Pass { uint mode; uint step; } pass;
ivec2 bounded(ivec2 p) { return clamp(p,ivec2(0),ivec2(temporal.target.xy)-1); }
vec3 normalAt(ivec2 p) { return NRD_FrontEnd_UnpackNormalAndRoughness(imageLoad(guideNormal,bounded(p))).xyz; }
float depthAt(ivec2 p) { return imageLoad(guideDepth,bounded(p)).x; }
vec3 viewPosition(vec2 uv,float z) {
  vec4 ray=temporal.previousView*temporal.previousInverseCamera*vec4(uv*2-1,.99999,1);
  return ray.xyz*(z/max(abs(ray.z),1e-8));
}
vec4 gradient(ivec2 p) { return (pass.step&1u)!=0?imageLoad(gradientA,p):imageLoad(gradientB,p); }
vec3 compressed(vec3 c) { return c/(1+max(c.r,max(c.g,c.b))); }
float uncharted(float x) { return ((x*(.22*x+.03)+.002)/(x*(.22*x+.3)+.06))-(.01/.3); }
float toSrgb(float x) { return x<=.0031308?12.92*x:1.055*pow(x,1.0/2.4)-.055; }
vec3 expanded(vec3 c) { return c/max(1-max(c.r,max(c.g,c.b)),1e-5); }
vec4 historyAt(ivec2 p) { return temporal.flags.w==0?imageLoad(history0,bounded(p)):imageLoad(history1,bounded(p)); }
vec4 historyFiltered(vec2 p) {
  ivec2 base=ivec2(floor(p));vec2 f=fract(p);
  return mix(mix(historyAt(base),historyAt(base+ivec2(1,0)),f.x),mix(historyAt(base+ivec2(0,1)),historyAt(base+1),f.x),f.y);
}
bool guideHistoryValid(vec2 p,float z,vec3 normal) {
  ivec2 base=ivec2(floor(p));vec2 f=fract(p);float support=0;
  // A subpixel silhouette can land on the other side of a point-sampled guide.
  // Accept matching geometry within the reprojection footprint instead of
  // dropping accumulated edge coverage whenever the nearest texel changes.
  for(int y=0;y<2;++y)for(int x=0;x<2;++x) {
    ivec2 q=base+ivec2(x,y);
    if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,ivec2(temporal.target.xy))))continue;
    float oldZ=imageLoad(previousDepth,q).x;
    vec3 oldNormal=NRD_FrontEnd_UnpackNormalAndRoughness(imageLoad(previousNormal,q)).xyz;
    if(abs(oldZ-z)<max(.02*z,.01)&&dot(normal,oldNormal)>.5)
      support+=(x==0?1-f.x:f.x)*(y==0?1-f.y:f.y);
  }
  return support>.05;
}
vec3 filteredForeground(ivec2 p,vec4 factor) {
  vec3 diffuse=REBLUR_BackEnd_UnpackRadianceAndNormHitDist(imageLoad(frontDiffuseOutput,p)).rgb;
  vec3 specular=REBLUR_BackEnd_UnpackRadianceAndNormHitDist(imageLoad(frontSpecularOutput,p)).rgb;
  return factor.a*(diffuse*factor.rgb+specular*imageLoad(frontSpecularFactor,p).rgb);
}
void main() {
  ivec2 p=ivec2(gl_GlobalInvocationID.xy);ivec2 size=ivec2(temporal.target.xy);
  if(pass.mode==0) {
    ivec2 small=imageSize(gradientA);if(any(greaterThanEqual(p,small)))return;
    vec4 center=gradient(p);vec3 N=decodeNormal(center.yz);
    vec3 X=viewPosition((vec2(p)*5+2.5)/vec2(size),center.w);
    float sum=1;float value=center.x;
    for(int y=-2;y<=2;++y)for(int x=-2;x<=2;++x) {
      if(x==0&&y==0)continue;
      ivec2 q=clamp(p+ivec2(x,y)*int(pass.step),ivec2(0),small-1);vec4 v=gradient(q);
      vec3 Xq=viewPosition((vec2(q)*5+2.5)/vec2(size),v.w);
      float distance=abs(dot(N,Xq-X));float scale=max(.02*abs(center.w),.02);
      float w=exp(-.5*float(x*x+y*y))*pow(max(dot(N,decodeNormal(v.yz)),0),2)*smoothstep(1,0,distance/scale);
