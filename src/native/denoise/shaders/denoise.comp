      // Track the dominant layer coherently; raster feedback depth is separate.
      if(factor.a>=.5) {
        imageStore(guideDepth,p,imageLoad(frontDepth,p));
        imageStore(guideMotion,p,imageLoad(frontMotion,p));
        imageStore(guideNormal,p,imageLoad(frontNormal,p));
        imageStore(rrNormal,p,NRD_FrontEnd_UnpackNormalAndRoughness(imageLoad(frontNormal,p)));
        imageStore(rrHitDistance,p,vec4(imageLoad(frontSpecularFactor,p).a));
      }
    }
    return;
  }
  if(pass.mode==1) {
    vec2 prev=vec2(p)+imageLoad(guideMotion,p).xy+temporal.jitter.xy-temporal.jitter.zw;
    float c=imageLoad(gradientB,clamp(ivec2(prev)/5,ivec2(0),imageSize(gradientB)-1)).x;
    // Motion w: 0 invalid, else 1 + the surface's own motion in pixels; a
    // moving surface's indirect history is stale (the gradient pass cannot
    // compare it: its depth changed under the previous ray).
