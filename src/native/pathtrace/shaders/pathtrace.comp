#ifdef SHARC_QUERY
bool cacheRadiance(Hit hit,float segmentLength,out vec3 radiance) {
  if(!hit.cacheable||hit.blended)return false;
  SharcParameters parameters=cacheParameters();
  uint level=HashGridGetLevel(hit.p,parameters.hashGridParameters);
  float voxel=HashGridGetVoxelSize(level,parameters.hashGridParameters);
  // Only view-independent legacy diffuse surfaces enter this cache.
  // EON/GGX material hits continue tracing instead of reusing outgoing radiance.
  if(segmentLength<=voxel*1.732050808)return false;
#ifndef CONFIDENCE_PASS
  bool measure=(hash(gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*frame.target.x)&63u)==0;
  if(measure)atomicAdd(CacheCounters(frame.sharcCounters).data[1],1u);
#endif
  bool found=SharcGetCachedRadiance(parameters,cacheHit(hit),radiance,false);
  found=found&&!any(isnan(radiance))&&!any(isinf(radiance));
#ifndef CONFIDENCE_PASS
  if(found&&measure)atomicAdd(CacheCounters(frame.sharcCounters).data[2],1u);
#endif
