    vec2 ua=s.vertices.v[s.indices.i[tri]].uv.xy;
    vec2 ub=s.vertices.v[s.indices.i[tri+1]].uv.xy;
    vec2 uc=s.vertices.v[s.indices.i[tri+2]].uv.xy;
    vec3 normal=vertexNormal(s.vertices.v[s.indices.i[tri]])*w.x+
      vertexNormal(s.vertices.v[s.indices.i[tri+1]])*w.y+vertexNormal(s.vertices.v[s.indices.i[tri+2]])*w.z;
    normal=shadingNormal(transpose(mat3(rayQueryGetIntersectionWorldToObjectEXT(query,true)))*normal,hit.ng,hit.wo);
