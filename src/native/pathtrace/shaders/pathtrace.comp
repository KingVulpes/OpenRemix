  mat2 M1=transpose(mat2(.99044,-1.28514,1.29678,-.755907));
  mat3 M2=transpose(mat3(1,2.92338,59.4188,20.3225,-27.0302,222.592,121.563,626.13,316.627));
  mat2 M3=transpose(mat2(.0365463,3.32707,9.0632,-9.04756));
  mat3 M4=transpose(mat3(1,3.59685,-1.36772,9.04401,-16.3174,9.22949,5.56589,19.7886,-20.2123));
  float bias=dot(M1*X.xy,Y.xy)/dot(M2*X.xyw,Y.xyw);
