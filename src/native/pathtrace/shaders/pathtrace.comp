  uint tri=rayQueryGetIntersectionPrimitiveIndexEXT(query,true)*3;
  vec3 a=s.vertices.v[s.indices.i[tri]].position.xyz;
  vec3 b=s.vertices.v[s.indices.i[tri+1]].position.xyz;
  vec3 c=s.vertices.v[s.indices.i[tri+2]].position.xyz;
  vec2 bary=rayQueryGetIntersectionBarycentricsEXT(query,true);
  mat4x3 model=rayQueryGetIntersectionObjectToWorldEXT(query,true);
  // Reconstruct on the triangle, then transform; see Ray Tracing Gems chapter 6.
  hit.p=model*vec4(a + bary.x*(b-a) + bary.y*(c-a),1);
  hit.n=normalize(cross(model*vec4(b-a,0),model*vec4(c-a,0)));
  if (dot(hit.n,direction)>0) hit.n=-hit.n;
  hit.color=albedo(s,tri/3,bary);
  hit.blended=(s.state.w&2)!=0;
  hit.previousPosition=hit.p;hit.historyValid=false;
#ifdef TEMPORAL
  if(s.previousVertices!=0) {
    Vertices previous=Vertices(s.previousVertices);
    vec3 pa=previous.v[s.indices.i[tri]].position.xyz;
    vec3 pb=previous.v[s.indices.i[tri+1]].position.xyz;
    vec3 pc=previous.v[s.indices.i[tri+2]].position.xyz;
    hit.previousPosition=(s.previousModel*vec4(pa+bary.x*(pb-pa)+bary.y*(pc-pa),1)).xyz;
    hit.historyValid=true;
  }
#endif
}
Hit closest(vec3 origin,vec3 direction) {
  Hit hit; hit.t=1e30; hit.p=vec3(0);hit.n=vec3(0);hit.color=vec4(0);hit.blended=false;hit.previousPosition=vec3(0);hit.historyValid=false;
  if ((frame.target.z&1)!=0) queryScene(staticScene,origin,direction,hit);
  if ((frame.target.z&2)!=0) queryScene(dynamicScene,origin,direction,hit);
  return hit;
}
// First visibility comes from rasterization; secondary rays still query the full scene.
Hit rasterPrimary(ivec2 pixel, vec3 origin) {
  vec4 position=imageLoad(primaryPosition,pixel), normal=imageLoad(primaryNormal,pixel);
  vec4 previous=imageLoad(primaryPrevious,pixel);
  Hit hit;
  hit.t=normal.w==0?1e30:length(position.xyz-origin);
  hit.p=position.xyz;hit.n=normal.w==0?vec3(0):normalize(normal.xyz);
  hit.color=imageLoad(primaryAlbedo,pixel);hit.blended=normal.w==2;
  hit.previousPosition=previous.xyz;hit.historyValid=previous.w!=0;
  return hit;
}
// Scale-aware integer ULP offset with a near-origin fallback (RT Gems, ch. 6).
vec3 offsetRay(vec3 p,vec3 n) {
  ivec3 step=ivec3(256.0*n);
  vec3 shifted=intBitsToFloat(floatBitsToInt(p)+mix(step,-step,lessThan(p,vec3(0))));
  return mix(shifted,p+n*(1.0/65536.0),lessThan(abs(p),vec3(1.0/32.0)));
}
// Cosine-weighted hemisphere: disk projection, pdf = cos(theta)/pi (ch. 15-16).
vec3 diffuseDirection(vec3 n) {
  float u=random(), angle=6.28318530718*random();
  vec3 t=normalize(cross(abs(n.z)<0.999 ? vec3(0,0,1) : vec3(0,1,0),n));
  return normalize(t*(sqrt(u)*cos(angle))+cross(n,t)*(sqrt(u)*sin(angle))+n*sqrt(1-u));
}
vec3 shadow(vec3 origin,vec3 direction) {
  vec3 transmission=vec3(1);
  for (uint layer=0;layer<32;++layer) {
    Hit hit=closest(origin,direction);
    if (hit.t==1e30) return transmission;
    if (!hit.blended) return vec3(0);
    transmission*=hit.color.rgb*(1-hit.color.a);
    origin=offsetRay(hit.p,-hit.n);
  }
  return vec3(0); // Conservative bound, independent of diffuse bounce depth.
}
vec3 direct(Hit hit) {
  vec3 toLight=-frame.lightDirection.xyz;
  float cosine=max(0,dot(hit.n,toLight));
  return cosine>0?hit.color.rgb*(cosine/3.14159265359)*frame.lightRadiance.rgb*shadow(offsetRay(hit.p,hit.n),toLight):vec3(0);
}
vec3 continuation(Hit primary,out vec3 firstDirection,out float firstDistance) {
  firstDirection=diffuseDirection(primary.n);firstDistance=0;
  vec3 direction=firstDirection,origin=offsetRay(primary.p,primary.n),throughput=vec3(1),result=vec3(0);
  uint bounce=0,layers=0;
  for(uint step=0;step<164&&bounce<frame.config.y;++step) {
    Hit hit=closest(origin,direction);
    if(bounce==0)firstDistance+=hit.t;
    if(hit.t==1e30) { result+=throughput*frame.skyRadiance.rgb;break; }
    if(hit.blended&&random()>=hit.color.a) {
      if(++layers>=32)break;
      throughput*=hit.color.rgb;origin=offsetRay(hit.p,-hit.n);continue;
    }
    result+=throughput*direct(hit);
    if(++bounce>=frame.config.y)break;
    throughput*=hit.color.rgb;direction=diffuseDirection(hit.n);origin=offsetRay(hit.p,hit.n);layers=0;
  }
  return result;
}
void ray(vec2 ndc,mat4 inverseCamera,out vec3 origin,out vec3 direction) {
  vec4 nearPoint=inverseCamera*vec4(ndc,0,1),farPoint=inverseCamera*vec4(ndc,.99999,1);
  origin=nearPoint.xyz/nearPoint.w;direction=normalize(farPoint.xyz/farPoint.w-origin);
}
void main() {
  ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
#ifdef CONFIDENCE_PASS
  if(any(greaterThanEqual(pixel,imageSize(gradientA))))return;
  ivec2 fullPixel=min(pixel*5+2,ivec2(frame.target.xy)-1);
  vec3 origin,direction;
  ray((vec2(fullPixel)+.5+temporal.jitter.zw)/vec2(frame.target.xy)*2-1,temporal.previousInverseCamera,origin,direction);
  rng=hash(uint(fullPixel.x)+uint(fullPixel.y)*frame.target.x+hash(temporal.target.z));
  Hit hit=closest(origin,direction);
  for(uint layer=0;layer<32&&hit.blended;++layer){origin=offsetRay(hit.p,-hit.n);hit=closest(origin,direction);}
  vec3 current=vec3(0);vec3 firstDir;float firstDist;
  if(hit.t<1e30)for(uint i=0;i<frame.config.x;++i)current+=continuation(hit,firstDir,firstDist)/float(frame.config.x);
  vec3 old=imageLoad(previousLighting,fullPixel).rgb;
  float delta=dot(abs(current-old),vec3(.2126,.7152,.0722));
  float z=hit.t<1e30?abs((temporal.previousView*vec4(hit.p,1)).z):65000;
  float prevZ=imageLoad(previousDepth,fullPixel).x;
  vec3 normal=hit.t<1e30?normalize(mat3(temporal.previousView)*hit.n):vec3(0,0,1);
  if(temporal.flags.x!=0||abs(z-prevZ)>max(.02*z,.01))delta=0;
  imageStore(gradientA,pixel,vec4(delta,encodeNormal(normal),min(z,65000)));return;
#else
