vec3 shadow(vec3 origin,vec3 direction) {
  vec3 transmission=vec3(1);
  for (uint layer=0;layer<32;++layer) {
    VisibilityHit hit=visibilityHit(origin,direction,true);
    if (hit.blocked) return vec3(0);
    if (hit.t==1e30) return transmission;
    transmission*=hit.transmission;
    origin=offsetRay(hit.p,-hit.n);
  }
  return vec3(0); // Conservative bound, independent of diffuse bounce depth.
}
#include "blue_noise.glsl"
// Independent primary-shadow sampling preserves the diffuse/confidence RNG.
// The first attenuating sheet provides a finite penumbra even if the ray later
// escapes; otherwise SIGMA would classify tinted transmission as fully lit.
vec3 sunVisibility(Hit receiver,ivec2 pixel,out float blockerDistance) {
  vec3 center=-frame.lightDirection.xyz;
  blockerDistance=0;
  if(dot(receiver.n,center)<=0||all(equal(frame.lightRadiance.rgb,vec3(0))))return vec3(0);
  vec3 direction=center;
  if(frame.sun.x>0) {
    vec2 sampleU;
    if((uint(frame.jitter.w)&1u)!=0)sampleU=shadowBlueNoise(pixel,frame.config.z);
    else {
      // Full sequence for progressive references; the previous eight hashed
      // patterns remain available for filtered-shadow comparison/fallback.
      uint sequence=frame.sun.y!=0?(frame.config.z&7u):frame.config.z;
      uint state=hash(uint(pixel.x)+uint(pixel.y)*frame.target.x+hash(sequence+0xa511e9b3u));
      sampleU=vec2(state>>8,hash(state)>>8)*(1.0/16777216.0);
    }
    float u=sampleU.x,angle=6.28318530718*sampleU.y;
    vec3 t=normalize(cross(abs(center.z)<.999?vec3(0,0,1):vec3(0,1,0),center));
    direction=normalize(center+frame.sun.x*sqrt(u)*(cos(angle)*t+sin(angle)*cross(center,t)));
  }
  if(dot(receiver.n,direction)<=0)return vec3(0);
  vec3 transmission=vec3(1),origin=offsetRay(receiver.p,receiver.ng);
  float distance=0;blockerDistance=65504;
  for(uint layer=0;layer<32;++layer) {
    VisibilityHit hit=visibilityHit(origin,direction,false);
    if(hit.t==1e30)return transmission;
    distance+=hit.t;
    if(hit.blocked){blockerDistance=min(distance,65000);return vec3(0);}
    vec3 tint=hit.transmission;
    if(any(lessThan(tint,vec3(.999))))blockerDistance=min(blockerDistance,min(distance,65000));
    transmission*=tint;
    origin=offsetRay(hit.p,-hit.n);
  }
