  // plane without meeting that surface behind it left the painted surface
  // itself (bounce, sky and light rays from under the paint): it must not see
  // the paint, which would otherwise shade its own receiver.
  const float attach=frame.visibilityProbe.y;
  const bool attached=hit.t<1e30&&!hit.decal&&hit.t-lastDecal<=attach;
