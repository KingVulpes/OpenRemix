    vec4 clip=frame.camera*vec4(direction,0),prev=temporal.previousCamera*vec4(direction,0);
    if(prev.w>0&&clip.w>0)mv=vec4((prev.xy/prev.w-clip.xy/clip.w)*.5*vec2(frame.target.xy),0,1);
