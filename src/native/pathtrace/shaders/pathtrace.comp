Hit closest(vec3 origin,vec3 direction) { return closest(origin,direction,1e30,true); }
Hit secondaryHit(vec3 origin,vec3 direction) { return closest(origin,direction,1e30,false); }
// First visibility comes from rasterization; secondary rays still query the full scene.
Hit rasterPrimary(ivec2 pixel, vec3 origin) {
