float nearestDistance(float a,float b) { return a>0&&b>0?min(a,b):max(a,b); }
// Local NEE and continuation share one PBR diffuse/specular history. The same
// selected light, visibility and PDF feed both lobes; no additional rays.
void addPbrLocal(ivec2 pixel,Hit hit,vec3 total,vec3 specular,float distance) {
  vec3 factor=materialFactor(hit);
  vec3 diffuseFactor=imageLoad(guideAlbedo,pixel).rgb;
  vec3 specularFactor=imageLoad(pbrSpecularFactor,pixel).rgb;
  vec4 diffuse=REBLUR_BackEnd_UnpackRadianceAndNormHitDist(imageLoad(sh0,pixel));
  vec4 reflected=REBLUR_BackEnd_UnpackRadianceAndNormHitDist(imageLoad(pbrSpecularInput,pixel));
  diffuse.rgb+=max(total-specular,vec3(0))*factor/diffuseFactor;
  reflected.rgb+=specular*factor/specularFactor;
  float z=imageLoad(guideDepth,pixel).x;
  diffuse.a=nearestDistance(diffuse.a,REBLUR_FrontEnd_GetNormHitDist(distance,z,temporal.hitDistance.xyz,1));
  reflected.a=nearestDistance(reflected.a,REBLUR_FrontEnd_GetNormHitDist(distance,z,temporal.hitDistance.xyz,hit.rm.x));
  imageStore(sh0,pixel,REBLUR_FrontEnd_PackRadianceAndNormHitDist(diffuse.rgb,diffuse.a,true));
  imageStore(pbrSpecularInput,pixel,REBLUR_FrontEnd_PackRadianceAndNormHitDist(reflected.rgb,reflected.a,true));
