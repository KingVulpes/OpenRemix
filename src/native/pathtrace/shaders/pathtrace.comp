uint rng;
uint hash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; return x ^ (x >> 16); }
float random() { rng = hash(rng + 0x9e3779b9u); return float(rng >> 8) * (1.0 / 16777216.0); }
vec4 albedo(Surface s, uint triangle, vec2 bary) {
  uint base = triangle * 3;
  Vertex a = s.vertices.v[s.indices.i[base]], b = s.vertices.v[s.indices.i[base+1]], c = s.vertices.v[s.indices.i[base+2]];
  vec3 w = vec3(1-bary.x-bary.y, bary);
  return materialColor(s, a.uv.xy*w.x + b.uv.xy*w.y + c.uv.xy*w.z, a.color*w.x + b.color*w.y + c.color*w.z);
}
struct Hit { float t; vec3 p; vec3 n; vec4 color; bool blended; vec3 previousPosition; bool historyValid; };
void queryScene(accelerationStructureEXT scene, vec3 origin, vec3 direction, inout Hit hit) {
  rayQueryEXT query;
