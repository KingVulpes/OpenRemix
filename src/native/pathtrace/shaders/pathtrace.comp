// Independent sparse paths, distributed across every pixel in a tile over time.
// Update direct outgoing radiance at each opaque static hit, then propagate
// per-segment reflectance/transmission. NRD-Sample uses the same SDK contract.
void updateCache(ivec2 pixel) {
  uint downscale=frame.sharcConfig.z;
  uint phase=frame.config.z%(downscale*downscale);
  pixel=pixel*int(downscale)+ivec2(phase%downscale,phase/downscale);
  if(any(greaterThanEqual(pixel,ivec2(frame.target.xy))))return;
  rng=hash(uint(pixel.x)+uint(pixel.y)*frame.target.x+hash(frame.config.z)^0x53484152u);
  vec3 origin,direction;
  ray((vec2(pixel)+.5+frame.jitter.xy)/vec2(frame.target.xy)*2-1,frame.inverseCamera,origin,direction);
  SharcParameters parameters=cacheParameters();SharcState state;SharcInit(state);
  uint bounce=0,layers=0;
  atomicAdd(CacheCounters(frame.sharcCounters).data[0],1u);
  for(uint step=0;step<164&&bounce<=frame.config.y;++step) {
    Hit hit=secondaryHit(origin,direction);
    if(hit.t==1e30) { SharcUpdateMiss(parameters,state,frame.skyRadiance.rgb);break; }
    // A sparse update chooses among the visible sheets and opaque background
    // stochastically. This also trains surfaces reached from water when the
    // opaque primary guide is sky (for example, looking up from underwater).
    if(hit.blended&&random()>=hit.color.a) {
      if(++layers>=32)break;
      if(bounce!=0)SharcSetThroughput(state,hit.color.rgb);
      origin=offsetRay(hit.p,-hit.ng);continue;
    }
    vec3 lighting=direct(hit);
    if(hit.cacheable&&!hit.blended) {
      if(!SharcUpdateHit(parameters,state,cacheHit(hit),lighting,random()))break;
    } else {
      // Moving geometry and blended sheets affect other cached vertices, but
      // never insert or query their own shared surface entry.
      SharcUpdateMiss(parameters,state,lighting);
    }
    if(++bounce>frame.config.y)break;
    vec3 weight=materialSample(hit,direction);
    SharcSetThroughput(state,weight);
    origin=offsetRay(hit.p,hit.ng);layers=0;
    if(!any(greaterThan(weight,vec3(0))))break;
  }
}
#endif
