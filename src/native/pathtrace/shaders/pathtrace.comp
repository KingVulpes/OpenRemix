// Geometry diagnostics show the first visible sheet. Lighting and temporal
// guides belong to the opaque receiver behind transparent sheets.
vec3 debugGeometry(Hit hit,ivec2 pixel) {
  uint view=frame.splitLocal.w;
  if(view>=8)return debugUnavailable(pixel); // filled by temporal composition when available
  if(hit.t==1e30)return vec3(0);
  if(view==1)return hit.color.rgb;
  if(view==2)return hit.n*.5+.5;
  if(view==3)return debugPalette(hit.identity);
  if(view==4)return vec3(fract(length(hit.p-frame.eye.xyz)/4));
  if(view==5)return .15+.7*fract(hit.p); // one world unit per cell
