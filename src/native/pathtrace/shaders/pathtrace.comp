// Accumulate exactly the same per-sample signals in either dispatch. Only
// radiance and the final integer RNG travel through scratch; the producer can
// write denoiser inputs directly at their normal output precision.
vec3 rrSpecularAlbedo(vec3 f0,float roughness,float NoV) {
  float alpha=roughness*roughness; NoV=abs(NoV);
