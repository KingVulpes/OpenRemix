// Tagged decals coat the receiver's material; lighting is evaluated and filtered
// once on that receiver. This also gives partial decal texels stable motion/NRD
// guides instead of feeding their independently sampled lighting around NRD.
Hit resolveDecals(Hit first,vec3 origin,vec3 direction,float maximum,bool motion) {
  if(!enableDecals||!first.decal)return first;
