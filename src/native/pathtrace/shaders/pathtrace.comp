}
Hit closest(vec3 origin,vec3 direction,float maximum,bool motion) {
  Hit hit; hit.t=maximum; hit.p=vec3(0);hit.n=vec3(0);hit.color=vec4(0);hit.blended=false;hit.cacheable=false;hit.previousPosition=vec3(0);hit.historyValid=false;
  hit.emission=vec3(0);
  hit.identity=0;hit.ng=vec3(0);hit.wo=-direction;hit.rm=vec2(1,0);hit.pbr=false;
  if ((frame.target.z&1)!=0) queryScene(staticScene,origin,direction,hit,motion);
  if ((frame.target.z&2)!=0) queryScene(dynamicScene,origin,direction,hit,motion);
  if(hit.t==maximum)hit.t=1e30;
