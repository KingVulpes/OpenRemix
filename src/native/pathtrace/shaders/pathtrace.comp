layout(local_size_x=8, local_size_y=8) in;
#include "scene.glsl"
layout(set=0,binding=0) uniform accelerationStructureEXT staticScene;
layout(set=0,binding=1) uniform accelerationStructureEXT dynamicScene;
layout(set=0,binding=4,rgba32f) uniform image2D worldColor;
layout(set=0,binding=5,rgba32f) uniform image2D backgroundTransmission;
layout(set=0,binding=7,rgba32f) readonly uniform image2D rawSky;

layout(set=0,binding=8,rgba32f) readonly uniform image2D primaryPosition;
layout(set=0,binding=9,rgba16f) readonly uniform image2D primaryNormal;
layout(set=0,binding=10,rgba8) readonly uniform image2D primaryAlbedo;
