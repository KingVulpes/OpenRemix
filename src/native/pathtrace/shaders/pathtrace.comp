vec4 albedo(Surface s, uint triangle, vec2 bary) {
  uint base = triangle * 3;
  Vertex a = s.vertices.v[s.indices.i[base]], b = s.vertices.v[s.indices.i[base+1]], c = s.vertices.v[s.indices.i[base+2]];
  vec3 w = vec3(1-bary.x-bary.y, bary);
  return materialColor(s, a.uv.xy*w.x + b.uv.xy*w.y + c.uv.xy*w.z, a.color*w.x + b.color*w.y + c.color*w.z);
}
bool acceptCandidate(Surface s,uint triangle,vec2 bary) {
  if(s.state.y==7)return true;
  if(s.state.y==0)return false;
  if((s.state.w&1)!=0)return alphaPass(s,1);
  uint base=triangle*3;
  Vertex a=s.vertices.v[s.indices.i[base]],b=s.vertices.v[s.indices.i[base+1]],c=s.vertices.v[s.indices.i[base+2]];
  vec3 w=vec3(1-bary.x-bary.y,bary);
  return alphaPass(s,materialAlpha(s,a.uv.xy*w.x+b.uv.xy*w.y+c.uv.xy*w.z,a.color.a*w.x+b.color.a*w.y+c.color.a*w.z));
}
struct Hit { float t; vec3 p; vec3 n; vec4 color; bool blended; bool cacheable; vec3 previousPosition; bool historyValid; vec3 emission; float identity; vec3 ng; vec3 wo; vec2 rm; bool pbr; };
void queryScene(accelerationStructureEXT scene, vec3 origin, vec3 direction, inout Hit hit,bool motion) {
