  // Shared with raster visibility and sky; zero unless TAA or accumulation can resolve it.
  vec2 jitter=frame.jitter.xy;
  vec3 origin,direction;ray((vec2(pixel)+.5+jitter)/vec2(frame.target.xy)*2-1,frame.inverseCamera,origin,direction);
  Hit primary=frame.target.w!=0?rasterPrimary(pixel,origin):closest(origin,direction);
  vec3 tint=vec3(1),transparent=vec3(0);float opacityProduct=1;
  // Bounded straight-through primary composition. Blended surfaces never supply NRD guides.
  // Shade sheets after the opaque sample below so confidence retracing uses the same seeds.
  Hit sheets[32];uint sheetCount=0;
  while(primary.blended&&sheetCount<32) {
    sheets[sheetCount++]=primary;origin=offsetRay(primary.p,-primary.n);primary=closest(origin,direction);
  }
  vec3 indirect=vec3(0),primaryDirect=vec3(0);vec4 packed0=vec4(0),packed1=vec4(0);
  if(primary.t<1e30&&!primary.blended) {
    primaryDirect=direct(primary);
    for(uint i=0;i<frame.config.x;++i) {
      vec3 firstDir;float firstDist;vec3 sampleLight=continuation(primary,firstDir,firstDist);
      indirect+=sampleLight/float(frame.config.x);
#ifdef TEMPORAL
      float z=abs((temporal.view*vec4(primary.p,1)).z);
      vec4 one;packed0+=REBLUR_FrontEnd_PackSh(sampleLight,REBLUR_FrontEnd_GetNormHitDist(firstDist,z,temporal.hitDistance.xyz,1),firstDir,one,true)/float(frame.config.x);
      packed1+=one/float(frame.config.x);
#endif
    }
  }
  for(uint layer=0;layer<sheetCount;++layer) {
