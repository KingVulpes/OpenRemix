#usda 1.0
(
    defaultPrim = "RootNode"
    metersPerUnit = 1
    upAxis = "Y"
    customLayerData = {
        string lightspeed_layer_type = "capture"
        string unknown_capture_metadata = "preserve me"
    }
)
def Xform "RootNode" {
    def Scope "Looks" {
        def Material "mat_0123456789ABCDEF" {
            token outputs:mdl:surface.connect = </RootNode/Looks/mat_0123456789ABCDEF/Shader.outputs:out>
            def Shader "Shader" {
                color3f inputs:diffuse_color_constant = (0.7, 0.7, 0.7)
                float inputs:reflection_roughness_constant = 0.5
                int inputs:alpha_test_type = 7
                token outputs:out
            }
        }
    }
    def Scope "meshes" {
        def Xform "mesh_0123456789ABCDEF" {
            token visibility = "invisible"
            def Mesh "mesh" (prepend apiSchemas = ["MaterialBindingAPI"]) {
                rel material:binding = </RootNode/Looks/mat_0123456789ABCDEF>
                uniform token subdivisionScheme = "none"
                point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 3, 2, 1]
                float3[] normals = [(0, 1, 0)] (interpolation = "constant")
            }
        }
    }
    def Scope "instances" {
        def Xform "inst_0123456789ABCDEF_0" (
            prepend references = </RootNode/meshes/mesh_0123456789ABCDEF>
        ) {
            token visibility = "inherited"
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "inst_0123456789ABCDEF_1" (
            prepend references = </RootNode/meshes/mesh_0123456789ABCDEF>
        ) {
            token visibility = "inherited"
            double3 xformOp:translate = (4, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
