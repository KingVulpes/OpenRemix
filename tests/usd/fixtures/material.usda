#usda 1.0
(
    defaultPrim = "Material"
)
def Material "Material" {
    token outputs:mdl:surface.connect = </Material/Shader.outputs:out>
    def Shader "Shader" {
        color3f inputs:diffuse_color_constant = (0.1, 0.8, 0.2)
        float inputs:reflection_roughness_constant = 0.25
        bool inputs:enable_emission = false
        float inputs:emissive_intensity = 40
        int inputs:alpha_test_type = 7
        token outputs:out
    }
}
