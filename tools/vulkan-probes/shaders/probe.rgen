#version 460
#extension GL_EXT_ray_tracing : require
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, std430) buffer Results { float values[]; } result;
layout(location = 0) rayPayloadEXT float distance;

void main() {
  uint index = gl_LaunchIDEXT.x;
  distance = -2.0;
  traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
    vec3(index == 0 ? 0.0 : 10.0, 0.0, -1.0), 0.001, vec3(0.0, 0.0, 1.0), 100.0, 0);
  result.values[index] = distance;
}
